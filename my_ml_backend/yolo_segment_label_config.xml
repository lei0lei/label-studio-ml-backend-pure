<View>
  <Header value="YOLO 分割模板（PolygonLabels）"/>

  <Image
    name="image"
    value="$image"
    zoom="true"
    zoomControl="true"
    rotateControl="true"
    maxWidth="100%"/>

  <PolygonLabels
    name="label"
    toName="image"
    model_score_threshold="0.25"
    opacity="0.1">
    <Label value="person" background="#EF4444"/>
    <Label value="car" background="#3B82F6"/>
    <Label value="road" background="#22C55E"/>
  </PolygonLabels>
</View>
